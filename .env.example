# Copy this file to .env and fill in real values before deploying.
# Dokploy also lets you set these as "Environment Variables" in the
# app's UI instead of committing a .env file - either works.

# --- Domains routed through Traefik ---
DASHBOARD_DOMAIN=tb.example.com
MQTT_DOMAIN=mqtt.example.com

# --- Traefik cert resolver name configured in Dokploy (default: letsencrypt) ---
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- Postgres / ThingsBoard secrets ---
POSTGRES_DB=thingsboard
POSTGRES_USER=thingsboard
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- ThingsBoard runtime options ---
# Load demo data on first install (true/false). Only affects the initial
# install run - has no effect once .thingsboard-installed marker exists.
LOAD_DEMO=false
# Extra JVM flags for the ThingsBoard node, e.g. -Xms512M -Xmx2G
JAVA_OPTS=
# Comma-separated list of origins allowed to call the REST API from a browser.
# .env does not support referencing other variables, so repeat the real
# DASHBOARD_DOMAIN value here (with the https:// scheme) rather than nesting it.
SECURITY_CORS_ALLOWED_ORIGINS=https://tb.example.com
